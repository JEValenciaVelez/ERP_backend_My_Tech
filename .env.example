# Copia este archivo a .env y ajusta los valores.
# La validación (config/env.config.ts) corre al arrancar: si algo falta, el
# proceso termina con el detalle.

NODE_ENV=development
PORT=8300
DEFAULT_LANG=es
MULTI_CORE=0

# Base de datos propia del ERP, separada de la de cada producto.
DATABASE_URL=postgresql://usuario:password@localhost:5432/erp_db

# Orígenes del front, separados por coma. '*' solo para desarrollo.
CORS_ORIGINS=http://localhost:5174

# Saltos de proxy de confianza (en Render: 1). Define req.ip para el límite por IP.
TRUST_PROXY=0

# Ventanas del límite de intentos del login. Sin Redis se usa memoria.
REDIS_URL=redis://127.0.0.1:6379
LOGIN_VENTANA_SEGUNDOS=900
LOGIN_MAX_POR_CORREO=10
LOGIN_MAX_POR_IP=50

# Firma de los access token (mínimo 24 caracteres). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_ACCESS_TTL=12h

# Backend de ANT: adónde se envía accessUntil/maxUsers al registrar un pago.
# Vacío = el envío queda pendiente y se reintenta después.
ANT_API_URL=
ANT_SERVICE_TOKEN=

# Administrador inicial para el seed. Fuera de producción, vacío = admin@erp.dev / admin12345.
ADMIN_NOMBRE=
ADMIN_CORREO=
ADMIN_CLAVE=

# Observabilidad (opcional)
API_TOKEN_PINO=
