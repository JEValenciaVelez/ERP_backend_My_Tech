{
	"name": "erp-backend",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@10.30.3",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"postinstall": "prisma generate",
		"build": "rm -rf dist && tsc && cross-env NODE_ENV=production node esbuild.config.js",
		"dev": "rm -rf dist && node esbuild.config.js",
		"start": "node dist/erp.js",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev",
		"db:deploy": "prisma migrate deploy",
		"db:seed": "cross-env NODE_ENV=production node esbuild.config.js && node dist/seed.js",
		"db:studio": "prisma studio",
		"validate": "tsc",
		"test": "vitest run --reporter=verbose --no-isolate --no-coverage",
		"eslint": "eslint ./",
		"eslint:fix": "eslint ./ --fix"
	},
	"dependencies": {
		"@axiomhq/pino": "^1.4.0",
		"@prisma/adapter-pg": "^7.4.0",
		"@prisma/client": "^7.4.0",
		"bcryptjs": "^3.0.3",
		"dotenv": "^17.3.1",
		"express": "^5.2.1",
		"helmet": "^8.1.0",
		"jsonwebtoken": "^9.0.3",
		"moment": "^2.30.1",
		"pg": "^8.18.0",
		"pino": "^10.3.1",
		"redis": "^5.12.1",
		"tsconfig-paths": "^4.2.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.2",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^25.2.3",
		"@types/pg": "^8.16.0",
		"@types/supertest": "^6.0.3",
		"cross-env": "^10.1.0",
		"esbuild": "^0.27.3",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.5",
		"eslint-plugin-simple-import-sort": "^12.1.1",
		"prettier": "^3.8.1",
		"prisma": "^7.4.0",
		"supertest": "^7.2.2",
		"ts-node": "^10.9.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.55.0",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^4.0.18"
	}
}
